# App runtime
APP_ENV=local
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Docker Compose ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_DB=supinzhihang
POSTGRES_USER=supin_app
POSTGRES_PASSWORD=replace_with_local_only_password
DATABASE_URL=postgresql+psycopg://supin_app:replace_with_local_only_password@postgres:5432/supinzhihang

# Redis
REDIS_URL=redis://redis:6379/0

# Alibaba Cloud Bailian / DashScope
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.6-plus

# External data sources
ENABLE_YOUTUBE=true
ENABLE_ETSY=true
ENABLE_UN_COMTRADE=true
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
UN_COMTRADE_API_KEY=
RAKUTEN_APPLICATION_ID=
RAKUTEN_APP_ID=
YOUTUBE_DATA_API_KEY=
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback
